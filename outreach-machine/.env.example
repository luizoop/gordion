# Safe default: no real Microsoft request and no live send.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
LOG_LEVEL=info
DATABASE_URL=postgres://gordion:gordion-local-only@127.0.0.1:54329/gordion_outreach
ADMIN_API_KEY=replace-with-at-least-32-random-characters
MAIL_PROVIDER=simulated
LIVE_SEND_ENABLED=false

# Copy config/microsoft-365.example.json to config/microsoft-365.json locally.
# Replace example identities only after checking the actual tenant and primary SMTP.
# No automatic signature is configured.
GRAPH_AUTH_MODE=app_only
GRAPH_ACCESS_STAGE=read_only
GRAPH_TENANT_ID=00000000-0000-4000-8000-000000000001
GRAPH_MAILBOX_OBJECT_ID=00000000-0000-4000-8000-000000000002
GRAPH_SENDER_ADDRESS=outreach@example.org
# Set these ONLY after Exchange inspection and app registration:
# GRAPH_CLIENT_ID=<Application (client) ID>
# GRAPH_CERTIFICATE_PATH=<absolute path to public X.509 certificate outside repo>
# GRAPH_PRIVATE_KEY_PATH=<absolute path to PEM private key outside repo>
# GRAPH_MAILBOX_EVIDENCE_PATH=.outreach-data/mailbox-evidence.json
# GRAPH_CONTROL_MAILBOX_OBJECT_ID=<verified second, existing mailbox outside scope>
# GRAPH_CLIENT_SECRET is an alternative to a certificate for legacy local tests;
# do not combine both credential types. The setup probe uses certificates.
# Webhooks are optional for the read-only connection test; leave unconfigured now.
# GRAPH_WEBHOOK_CLIENT_STATE=<random 32+ characters>
# PUBLIC_BASE_URL=https://<future-internal-service-host>
## Local UI is opt-in and requires loopback + simulator + live sending disabled.
LOCAL_DASHBOARD_ENABLED=false
# Autopilot: exact database mailbox connection ID, never an address-only lookup.
# MAILBOX_CONNECTION_ID=<verified mailbox_connections.id>
# Operator password hash is created locally by npm run autopilot:operator-setup.
# Keep .outreach-data/operator.env private; never commit it.
# Shadow runtime: MAIL_PROVIDER=microsoft_graph, GRAPH_ACCESS_STAGE=read_only,
# LIVE_SEND_ENABLED=false. These switches do NOT approve templates or country rules.
# RESEARCH_IMPORT_API_KEY=separate-random-secret-at-least-32-characters
